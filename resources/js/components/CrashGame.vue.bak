<template>
  <div class="crash-game">
    <!-- Game Canvas -->
    <div class="game-canvas">
      <canvas ref="gameCanvas"></canvas>
      <div class="multiplier" v-if="isGameActive">
        {{ currentMultiplier.toFixed(2) }}x
      </div>
    </div>

    <!-- Betting Controls -->
    <div class="betting-controls">
      <input type="number" v-model="betAmount" :disabled="isGameActive" />
      <button @click="placeBet" :disabled="isGameActive">Place Bet</button>
      <button @click="cashOut" :disabled="!canCashOut">Cash Out</button>
    </div>

    <!-- Game History -->
    <div class="game-history">
      <h3>Recent Crashes</h3>
      <div class="history-points">
        <span v-for="point in gameHistory" :key="point.id"
          :class="{ red: point < 2, green: point >= 2 }">
          {{ point.toFixed(2) }}x
        </span>
      </div>
    </div>

    <!-- Chat Section -->
    <div class="chat-section">
      <div class="messages" ref="chatMessages">
        <div v-for="msg in chatMessages" :key="msg.id" class="message">
          <span class="username">{{ msg.username }}:</span>
          <span class="content">{{ msg.message }}</span>
        </div>
      </div>
      <input v-model="newMessage" @keyup.enter="sendMessage" placeholder="Type a message..." />
    </div>
  </div>
</template>
<script>
import { ref, onMounted, onUnmounted } from 'vue'
import Echo from 'laravel-echo'
import Reverb from '@soketi/reverb-js'

export default {
  name: 'CrashGame',
  setup() {
    const gameCanvas = ref(null)
    const currentMultiplier = ref(1.00)
    const isGameActive = ref(false)
    const betAmount = ref(10)
    const canCashOut = ref(false)
    const gameHistory = ref([])
    const chatMessages = ref([])
    const newMessage = ref('')

    let gameInterval
    let chart

    const echo = new Echo({
      broadcaster: 'reverb',
      key: import.meta.env.VITE_REVERB_APP_KEY,
      wsHost: import.meta.env.VITE_REVERB_HOST,
      wsPort: import.meta.env.VITE_REVERB_PORT,
      forceTLS: false,
      disableStats: true,
    })

    const handleGameUpdate = (data) => {
      currentMultiplier.value = data.multiplier
      updateGameState(data)
    }

    const updateGameState = (data) => {
      // Update game state based on received data
    }

    const placeBet = () => {
      // Send bet to server
      axios.post('/api/bets', {
        amount: betAmount.value
      })
      canCashOut.value = true
    }

    const cashOut = () => {
      // Send cashout request to server
      axios.post('/api/cashout')
      canCashOut.value = false
    }

    const updateChart = () => {
      // Update chart animation
    }

    onMounted(() => {
      echo.channel('game')
        .listen('GameUpdate', (e) => {
          handleGameUpdate(e)
        })

      echo.join('game')
        .here((users) => {
          console.log('Users currently online:', users)
        })
        .joining((user) => {
          console.log('User joined:', user)
        })
        .leaving((user) => {
          console.log('User left:', user)
        })
    })

    onUnmounted(() => {
      clearInterval(gameInterval)
    })

    return {
      gameCanvas,
      currentMultiplier,
      isGameActive,
      betAmount,
      canCashOut,
      gameHistory,
      chatMessages,
      newMessage,
      placeBet,
      cashOut
    }
  }
}
</script>
<style scoped>
.crash-game {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  padding: 20px;
  background: #1a1a1a;
  color: white;
}

.game-canvas {
  position: relative;
  background: #000;
  border-radius: 10px;
  overflow: hidden;
}

.multiplier {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48px;
  font-weight: bold;
  color: #00ff00;
}

/* Add more styles as needed */
</style>
